# --- uv (Package Manager & Environments) ---
# Ignores uv's managed virtual environments and lock file artifacts
.venv/
uv.lock
.uv/

# --- Python Build & Runtime Cache ---
# Ignores compiled bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- VS Code ---
# Ignores user-specific workspace configurations, while allowing extensions settings if needed
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Environments & Secrets ---
# Crucial: Never commit your secrets, passwords, or API keys
.env
.env.*
vars.env
*.png
*.txt